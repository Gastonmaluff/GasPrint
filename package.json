{
  "name": "gasprint",
  "version": "0.1.0",
  "productName": "GasPrint",
  "description": "GasPrint, puente local de impresion para Windows.",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist/main/index.js dist/preload/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "npm run build && node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint .",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test --enable-logging",
    "smoke:api": "npm run build && electron . --smoke-test --api-self-test --enable-logging"
  },
  "build": {
    "appId": "com.gasprint.desktop",
    "productName": "GasPrint",
    "artifactName": "GasPrint Setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/index.js"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GasPrint",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.1.0",
    "vite": "^8.1.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "typescript": "^5.8.0",
    "wait-on": "^9.0.10"
  }
}